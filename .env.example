# Which AI reads the photos: gemini or claude. Only the matching key is needed.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the Gemini model (default: gemini-flash-latest).
GEMINI_MODEL=
# Shows the clearly labelled sample clear-out (no AI needed). true or false.
DEMO_MODE=true
# Optional n8n quote workflow. Leave empty to use the built-in price rules.
N8N_QUOTE_URL=
N8N_SECRET=
# Team console at /ops: passcode of at least 8 characters. Leave empty to disable the console.
OPS_PASSCODE=
# Job storage on Vercel: added automatically when a private Vercel Blob store is connected to the project.
# Not needed locally (jobs are saved in .data/jobs).
BLOB_READ_WRITE_TOKEN=
